# Backend admin login secret. Generate a private value; do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Public URL used in generated trap credentials and local browser setup.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional. Defaults to local SQLite; use managed PostgreSQL for hosting.
# DATABASE_URL=postgresql://user:password@host:5432/database
