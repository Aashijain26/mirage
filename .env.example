# Backend admin login secret. Generate a private value; do not commit .env.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Public URL used in generated trap credentials and local browser setup.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=

# Optional automatic GitHub decoy planting. Disabled until explicitly enabled.
# Use a fine-grained GitHub token limited to this repository with Contents: read/write.
AUTO_PLANT_ENABLED=false
AUTO_PLANT_INTERVAL_HOURS=24
GITHUB_TOKEN=
GITHUB_REPOSITORY=Aashijain26/mirage
GITHUB_DECOY_PATH=mirage-decoys/.env

# Optional. Leave unset for local SQLite; set the exact managed PostgreSQL URL for hosting.
# DATABASE_URL=postgresql://user:password@host:5432/database
