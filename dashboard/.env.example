# Mirage SOC Dashboard Environment Template

# API URL of the backend FastAPI service
# Leave empty for standalone mock mode or set to backend URL (e.g. http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Toggle Mock Mode:
# 'true'  -> Runs out-of-the-box with simulated incidents and zero external network requests
# 'false' -> Connects to live FastAPI backend
VITE_USE_MOCK=true

# Admin Bearer Token (optional dev convenience; entered on Login screen in Real API Mode)
VITE_ADMIN_TOKEN=
